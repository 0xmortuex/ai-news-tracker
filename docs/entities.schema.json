{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0xmortuex.github.io/ai-news-tracker/entities.schema.json",
  "title": "AI News Tracker entities.json (ai-news-entities/1)",
  "description": "Entity (company, model, product) and topic-tag counts over the last 7 UTC days with a per-day trend. Additive changes only within /1.",
  "type": "object",
  "required": ["schema", "schemaVersion", "generatedAt", "windowDays", "days", "entities", "tags"],
  "properties": {
    "schema": { "const": "ai-news-entities/1" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "windowDays": { "type": "integer", "minimum": 1 },
    "days": { "type": "array", "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } },
    "entities": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["name", "type", "count", "trend", "today", "prevAvg", "rising", "lastSeenAt"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["company", "model", "product"] },
          "count": { "type": "integer", "minimum": 1 },
          "trend": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "today": { "type": "integer", "minimum": 0 },
          "prevAvg": { "type": "number", "minimum": 0 },
          "rising": { "type": "boolean" },
          "lastSeenAt": { "type": "string", "format": "date-time" },
          "topTags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tag", "count", "trend"],
        "properties": {
          "tag": { "enum": ["release", "pricing", "safety", "research", "policy", "tooling"] },
          "count": { "type": "integer", "minimum": 0 },
          "trend": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
        }
      }
    }
  }
}
